# Contraseña del panel (usuario: cualquiera). Vacía = sin login (solo para uso local)
APP_PASSWORD=

# Carpeta de trabajo y clip de tu personaje
STORAGE_DIR=./storage
CHARACTER_CLIP=./assets/personaje_loop.mp4
FONT_NAME=Impact

# Voz desde texto: edge (incluida) | xtts (opcional)
TTS_ENGINE=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
XTTS_SPEAKER_WAV=./assets/mi_voz.wav

# Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
LANGUAGE=es

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_URL=http://localhost:8000

MAX_UPLOAD_MB=500
